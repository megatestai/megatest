#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Report fallow findings in the changed files. This report does not fail the check.
if command -v fallow >/dev/null; then
  FALLOW_UPDATE_CHECK=off fallow review --brief || true
else
  echo "fallow is not installed: no fallow report."
fi

# ============================================================================
# Biome Checks (format + lint staged TypeScript files)
# ============================================================================

# Skip if biome is not installed
if [[ ! -d "node_modules/@biomejs" ]]; then
  echo "pre-commit: biome not installed, skipping (run: npm install)" >&2
  exit 0
fi

# Get staged .ts files
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ts$' || true)

if [ -z "$STAGED_TS" ]; then
  exit 0
fi

echo "pre-commit: formatting staged TypeScript files..."
echo "$STAGED_TS" | xargs npx biome format --write >/dev/null 2>&1

# Re-stage formatted files
echo "$STAGED_TS" | xargs git add

echo "pre-commit: linting staged TypeScript files..."
echo "$STAGED_TS" | xargs npx biome lint || exit 1
